+def _syntax_problem(code: str) -> str | None:
+    try:
+        ast.parse(code)
+    except SyntaxError as e:
+        return f"syntax error at line {e.lineno}: {e.msg}."
+    return None
+
+
+def _is_cut_off(reply: str) -> bool:
+    return (reply or "").count("```") % 2 == 1
+
