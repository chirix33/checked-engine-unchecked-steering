{
  "_comment": "Rules for build_artifact.py. This file names the identifying strings it removes, so it must never be copied into the export.",
  "out_dir_name": "vouch_artifact",
  "tracked_exclude_prefixes": [
    "acmtrust_paper/",
    "checker/out/"
  ],
  "tracked_exclude_exact": [
    "README.md",
    ".gitignore",
    "manifests/abstract_draft.md"
  ],
  "paper": {
    "tracked_include_exact": [
      "acmtrust_paper/main.tex",
      "acmtrust_paper/macros.tex",
      "acmtrust_paper/results.tex",
      "acmtrust_paper/references.bib",
      "acmtrust_paper/latexmkrc",
      "acmtrust_paper/acmart.cls",
      "acmtrust_paper/ACM-Reference-Format.bst",
      "acmtrust_paper/figures/history_gap.pdf"
    ],
    "tracked_include_prefixes": [
      "acmtrust_paper/sections/",
      "acmtrust_paper/sensitivity/"
    ],
    "tracked_include_suffixes_under": {
      "acmtrust_paper/figures/": [
        ".tex"
      ]
    },
    "extra_dirs": [
      "acmtrust_paper/figures/src/history_gap",
      "acmtrust_paper/paper_numbers"
    ],
    "extra_dir_skip_names": [
      "node_modules",
      "dist",
      ".vite",
      "__pycache__",
      "playwright-report",
      "test-results"
    ]
  },
  "ignored_md_dirs": [
    "adapters/generic_tasks",
    "validation"
  ],
  "runs": {
    "dirs": [
      "runs/main_v1/wf_test",
      "runs/main_v1/ml_test",
      "runs/main_v1/wf_policy",
      "runs/main_v1/analysis_v1",
      "runs/main_v1/analysis_v2",
      "runs/main_v1/domain_tables_v1",
      "runs/main_v1/domain_tables_v2",
      "runs/main_v1/jev_long_context_v1",
      "runs/judges_main_v1",
      "runs/judges_jev_ledger",
      "runs/build_test_main_claude",
      "runs/build_test_judges",
      "runs/build_test_pilot_claude",
      "runs/build_test_assurance_claude",
      "runs/build_test_coding_agent",
      "runs/build_test_b0_claude",
      "runs/build_test_v1",
      "runs/build_test_r1",
      "runs/build_test_r1_claude",
      "runs/devs_gen",
      "runs/coding_agent",
      "runs/workflow_docs",
      "runs/mlsys_docs"
    ],
    "files": [
      "runs/main_v1/wf_test_summary.json",
      "runs/main_v1/ml_test_summary.json",
      "runs/main_v1/wf_policy_summary.json"
    ],
    "logs_dir": "runs/main_v1/logs",
    "logs_exclude_regex": [
      "^ollama_serve",
      "^wf_dev_",
      "^ml_dev_",
      "^paper_build",
      "^analysis_v1_partial",
      "^analysis_v1_noqwenreact"
    ],
    "dir_skip_names": [
      "_smoke_cap16k",
      "__pycache__"
    ]
  },
  "wsl": {
    "distro": "Ubuntu-24.04",
    "gen_dir": "~/trust2027/gen",
    "lock_file": "~/trust2027/requirements.lock",
    "dest": "programs/devs_gen",
    "lock_dest": "manifests/requirements_devs_gen_wsl.lock",
    "skip_dir_names": [
      "__pycache__"
    ],
    "skip_suffixes": [
      ".db",
      ".pyc"
    ]
  },
  "binary_suffixes": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".zip",
    ".db",
    ".pyc",
    ".bpf",
    ".woff",
    ".woff2",
    ".pkl",
    ".npy",
    ".npz",
    ".xlsx",
    ".docx",
    ".ico",
    ".ttf",
    ".otf"
  ],
  "generic": [
    {
      "name": "user-name-in-paths",
      "pattern": "aashraf",
      "repl": "user",
      "mode": "plain"
    },
    {
      "name": "name-with-date-1",
      "pattern": "Ashraf, (\\d{4}-\\d{2}-\\d{2})",
      "repl": "\\1",
      "mode": "plain"
    },
    {
      "name": "name-with-date-2",
      "pattern": "Ashraf (\\d{4}-\\d{2}-\\d{2})",
      "repl": "\\1",
      "mode": "plain"
    },
    {
      "name": "full-name",
      "pattern": "Ashraf Abdul-Muumin",
      "repl": "author",
      "mode": "author"
    },
    {
      "name": "first-name-possessive",
      "pattern": "Ashraf's",
      "repl": "author's",
      "mode": "author"
    },
    {
      "name": "first-name",
      "pattern": "Ashraf",
      "repl": "author",
      "mode": "author"
    },
    {
      "name": "first-name-other-case",
      "pattern": "(?i)\\bashraf\\b",
      "repl": "author",
      "mode": "author"
    },
    {
      "name": "advisor-possessive",
      "pattern": "Dr\\. Roy's",
      "repl": "advisor's",
      "mode": "author"
    },
    {
      "name": "advisor",
      "pattern": "Dr\\. Roy",
      "repl": "advisor",
      "mode": "author"
    },
    {
      "name": "handle",
      "pattern": "(?i)chirix\\w*",
      "repl": "anonymous",
      "mode": "plain"
    },
    {
      "name": "earlier-project-folder",
      "pattern": "MLSystem 2027",
      "repl": "EarlierProject",
      "mode": "plain"
    }
  ],
  "line_fixes": [
    {
